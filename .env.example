# docker compose 용. 복사: cp .env.example .env
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -base64 32   (API와 워커가 같이 쓰는 녹음 암호화 키 — 잃어버리면 녹음을 열 수 없어요)
RECORDING_KEY=
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000/api
# 비워두면 카카오/구글 버튼은 "준비 중"
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3000/auth/callback
# 브라우저 알림 키 (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
