DATABASE_URL=postgresql://postgres:postgres@localhost:5432/malang?schema=public
REDIS_URL=redis://localhost:6379
# openssl rand -hex 32
JWT_SECRET=change-me
# openssl rand -base64 32  (워커와 같은 값)
RECORDING_KEY=
STORAGE_DIR=./storage
WEB_ORIGIN=http://localhost:3000
PORT=4000
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=
# 비워두면 카카오/구글 버튼이 "준비 중"으로 표시돼요
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3000/auth/callback
# 브라우저 알림 (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# 이메일 인증·비밀번호 재설정 메일 (비우면 이메일 기능이 ‘서버 설정 전’으로 보임)
SMTP_URL=
MAIL_FROM=말랑말랑 <no-reply@example.com>
